# Banco: usuário de escrita (ingestão) e usuário somente leitura (API)
DATABASE_URL=postgresql+psycopg://votosbr:votosbr@localhost:5432/votosbr
DATABASE_URL_READONLY=postgresql+psycopg://votosbr_leitura:votosbr_leitura@localhost:5432/votosbr

# Raw store (respostas originais das fontes)
RAW_STORE_PATH=data/raw

# Cliente HTTP: identifique o projeto e um contato; limites conservadores (serviços públicos)
HTTP_USER_AGENT=VotosBR/0.1 (+https://github.com/votosbr; contato@exemplo.org)
HTTP_MAX_RPS_CAMARA=2
HTTP_MAX_RPS_SENADO=1

# Só para resolução de identidade; nunca exposto
DOCUMENTO_HMAC_SECRET=troque-este-segredo

# Ingestão incremental (seção 6.2.1)
INGESTAO_DATA_INICIAL=2026-11-01
JANELA_REVISAO_DIAS=7
TAMANHO_FATIA_DIAS=7

# Métricas e API
METRICA_N_MINIMO=10
API_CORS_ORIGINS=["http://localhost:5173"]
LOG_JSON=false
